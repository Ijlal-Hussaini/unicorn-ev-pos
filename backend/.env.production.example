# Production Environment Variables Template
# Copy this file to .env.production and fill in your actual values

PORT=5000

# MongoDB Connection (Use MongoDB Atlas for production)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/UnicornEV

# Frontend URL
FRONTEND_URL=http://localhost:5174

# Security Secrets (Generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=GENERATE_A_STRONG_SECRET_HERE
SESSION_SECRET=GENERATE_A_STRONG_SECRET_HERE

# Cloudinary Configuration
CLOUD_NAME=your_cloud_name
API_KEY=your_api_key
API_SECRET=your_api_secret

# Email Configuration (Use app-specific password for Gmail)
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_specific_password
